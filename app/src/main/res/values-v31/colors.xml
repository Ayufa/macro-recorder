<?xml version="1.0" encoding="utf-8"?>
<!-- v0.9: Android 12+ はアクセント色だけでなく、面・線・文字の色も端末のテーマ色（Material You の
     トーンパレット system_neutral* / system_accent*）から取る（R1.1 / R1.11）。
     Android 11 以前は values/colors.xml の固定色（ニュートラル + 青）がフォールバック。
     success / record / error は意味を持つ色なので固定のまま（Material の「カスタム色」の扱い）。 -->
<resources>
    <color name="md_primary">@android:color/system_accent1_600</color>
    <color name="md_on_primary">@android:color/system_accent1_0</color>
    <color name="md_primary_container">@android:color/system_accent1_100</color>
    <color name="md_on_primary_container">@android:color/system_accent1_900</color>
    <color name="md_inverse_primary">@android:color/system_accent1_200</color>
    <color name="md_secondary_container">@android:color/system_accent2_50</color>
    <color name="md_on_secondary_container">@android:color/system_accent2_900</color>
    <color name="md_surface">@android:color/system_neutral1_10</color>
    <color name="md_surface_container">@android:color/system_neutral1_0</color>
    <color name="md_surface_container_high">@android:color/system_neutral1_0</color>
    <color name="md_on_surface">@android:color/system_neutral1_900</color>
    <color name="md_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="md_ink_3">@android:color/system_neutral2_600</color>
    <color name="md_outline">@android:color/system_neutral2_500</color>
    <color name="md_outline_variant">@android:color/system_neutral2_100</color>
    <color name="md_inverse_surface">@android:color/system_neutral1_800</color>
    <color name="md_inverse_on_surface">@android:color/system_neutral1_50</color>
    <color name="md_grid">@android:color/system_neutral2_50</color>
</resources>
