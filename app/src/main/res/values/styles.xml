<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorPrimary">@color/md_primary</item>
    </style>
    <!-- v0.6: 独自の見た目のダイアログ / ボトムシート用ウィンドウ -->
    <style name="AppDialogWindow" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:textColorHint">@color/md_ink_3</item>
    </style>
    <style name="AppSheetWindow" parent="@style/AppDialogWindow">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
